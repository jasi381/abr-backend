# Copy to .env and `set -a; source .env; set +a` before `make run`.

# --- storage ---
STORAGE=s3                     # s3 | local
S3_BUCKET=abr-videos-yourname
S3_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:9000   # MinIO only
# S3_PATH_STYLE=true                  # MinIO only
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Serve HLS straight from a CDN instead of proxying through the API:
# PUBLIC_HLS_BASE_URL=https://dxxxxxxxx.cloudfront.net

# --- server ---
ADDR=:8080
DATA_DIR=./data
MAX_UPLOAD_MB=2048
WORKERS=1

# --- encoding ---
X264_PRESET=veryfast
SEGMENT_SECONDS=6
KEYFRAME_SECONDS=2
